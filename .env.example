# Copy this file to .env and fill in real values. Never commit .env.

# --- Django core -------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"  (production refuses to boot with a short/default key)
SECRET_KEY=
# Use config.settings.development ONLY on your own machine. On a server this must be production.
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# --- Database (production / MySQL) --------------------------------------
DB_NAME=savings_hub
DB_USER=savings_hub_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Redis / Celery -------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS -------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://example.com

# --- Email ------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- ioTec Pay ----------------------------------------------------------
# --- ioTec Pay (mobile money + Visa/Mastercard) ----------------------------------
# From the ioTec Pay portal. Put YOUR values in .env (never in this file, never in git).
# Names follow the portal: API key / Secret key. (IOTEC_CLIENT_ID / IOTEC_CLIENT_SECRET also work.)
IOTEC_BASE_URL=https://pay.iotec.io
IOTEC_API_KEY=
IOTEC_SECRET_KEY=
IOTEC_WALLET_ID=
IOTEC_TOKEN_URL=https://id.iotec.io/connect/token
IOTEC_CURRENCY=UGX
# Who pays ioTec's fee. Leave empty for ioTec's default, or ChargeCustomer (added on top) / ChargeWallet (taken from you).
IOTEC_CHARGES_CATEGORY=
# The ONE callback URL to register in the ioTec Pay portal (Wallet > Settings > Callback URLs).
# It must be this app's public https address and end in /api/iotec/callback  e.g. https://yourdomain.com/api/iotec/callback
# (The API has no per-request callback field, so this value is documentation + used by `manage.py iotec_check`.)
IOTECH_CALLBACK_URL=
# Random value you also enter as the "Security Header" in the portal; ioTec sends it on every callback.
# Accepted as  X-Callback-Secret: <value>  or  Authorization: Bearer <value>.   python -c "import secrets;print(secrets.token_urlsafe(32))"
IOTEC_CALLBACK_SECRET=
# Public base URL of this site. Must be https for card payers to be sent back to your "payment result" page.
SITE_URL=

# --- Business rule defaults (overridable at runtime via SystemSetting) --
DEFAULT_SUBSCRIPTION_PRICE_UGX=1000
DEFAULT_ROUTE_COMMISSION_PERCENT=10.00
CLAIM_CODE_EXPIRY_HOURS=48
DELIVERY_OTP_EXPIRY_MINUTES=30
DELIVERY_OTP_MAX_ATTEMPTS=5

# --- SMS: ioTec Messaging ---------------------------------------------------
# Get these from https://messaging.iotec.io -> Management > Settings > CONFIGURATION.
# They are DIFFERENT from the ioTec Pay credentials above. The API key is shown only once.
# Production defaults to the ioTec gateway; in development SMS is just logged to the console.
# SMS_GATEWAY_CLASS=notifications.services.sms_gateway.IoTecSMSGateway
IOTEC_MESSAGING_CLIENT_ID=
IOTEC_MESSAGING_API_KEY=
# How to write the recipient number: local (0712345678, as in the API docs) | international (256712345678) | plus (+256712345678)
IOTEC_MESSAGING_PHONE_FORMAT=local

# --- Monitoring / logging ---------------------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Security ---------------------------------------------------------------
# Admin two-factor is always ON in production. Reset a lost device with:
#   python manage.py reset_2fa +2567XXXXXXXX
